# Hand-written DEF for the dla.db round-trip tests (cells from tiny.lef).
VERSION 5.8 ;
DIVIDERCHAR "/" ;
BUSBITCHARS "[]" ;
DESIGN small ;
UNITS DISTANCE MICRONS 2000 ;
PROPERTYDEFINITIONS
  COMPONENTPIN designRuleWidth REAL ;
END PROPERTYDEFINITIONS
DIEAREA ( 0 0 ) ( 16000 11200 ) ;
ROW ROW_0 core 800 800 N DO 35 BY 1 STEP 800 0 ;
ROW ROW_1 core 800 6400 FS DO 35 BY 1 STEP 800 0 ;
ROW ROW_2 core 800 12000 N ;
TRACKS X 400 DO 20 STEP 800 LAYER M2 ;
TRACKS Y 400 DO 14 STEP 800 LAYER M1 M2 ;
GCELLGRID X 0 DO 3 STEP 8000 ;
VIAS 2 ;
  - V1_2x1 + RECT M1 ( -250 -150 ) ( 750 150 ) + RECT V1 ( -150 -150 ) ( 150 150 )
    + RECT V1 ( 350 -150 ) ( 650 150 ) + RECT M2 ( -170 -230 ) ( 670 230 ) ;
  - V1_gen + VIARULE V1_GEN + CUTSIZE 300 300 + LAYERS M1 V1 M2 + CUTSPACING 340 340
    + ENCLOSURE 100 0 80 20 + ROWCOL 1 2 ;
END VIAS
COMPONENTS 6 ;
  - u1 INV + PLACED ( 800 800 ) N ;
  - u2 INV + PLACED ( 4000 800 ) FN ;
  - u3 NAND2 + SOURCE NETLIST + FIXED ( 800 6400 ) FS ;
  - u4 NAND2 + PLACED ( 6400 6400 ) S ;
  - u5 INV + UNPLACED ;
  - u\[6\] INV + COVER ( 9600 800 ) E ;
END COMPONENTS
PINS 5 ;
  - a + NET a + DIRECTION INPUT + USE SIGNAL
    + LAYER M2 ( -160 0 ) ( 160 400 )
    + PLACED ( 1200 0 ) N ;
  - y[0] + NET y[0] + DIRECTION OUTPUT + USE SIGNAL + LAYER M2 ( -160 0 ) ( 160 400 ) + FIXED ( 2000 11200 ) S ;
  - y[1] + NET y[1] + DIRECTION OUTPUT ;
  - VDD + NET VDD + SPECIAL + DIRECTION INOUT + USE POWER ;
  - VSS + NET VSS + SPECIAL + DIRECTION INOUT + USE GROUND ;
END PINS
BLOCKAGES 2 ;
  - PLACEMENT + SOFT RECT ( 12000 800 ) ( 14000 6000 ) ;
  - LAYER M1 RECT ( 0 0 ) ( 400 400 ) RECT ( 400 400 ) ( 800 800 ) ;
END BLOCKAGES
SPECIALNETS 2 ;
  - VDD ( * VDD ) + USE POWER
    + ROUTED M1 300 + SHAPE FOLLOWPIN ( 800 6400 ) ( 28800 * )
    NEW M2 600 + SHAPE STRIPE ( 1600 800 ) ( * 11200 ) V1_gen ;
  - VSS ( * VSS ) + USE GROUND + FIXED M1 300 + SHAPE FOLLOWPIN ( 800 800 ) ( 28800 * ) ;
END SPECIALNETS
NETS 5 ;
  - a ( PIN a ) ( u1 A ) ( u3 A ) + USE SIGNAL
    + ROUTED M2 ( 1200 0 ) ( * 2400 ) V1_0
    NEW M1 ( 1200 2400 100 ) ( 2000 * 0 ) RECT ( -100 -50 100 50 )
    NEW M1 ( 2000 2400 ) VIRTUAL ( 2400 2400 ) ( 3000 * ) V1_2x1 N ;
  - n1 ( u1 Y ) ( u2 A ) ( u4 B ) + WEIGHT 2 ;
  - y[0] ( u2 Y ) ( PIN y[0] ) ;
  - y[1] ( u4 Y ) ( PIN y[1] ) + SOURCE NETLIST ;
  - n2 ( u3 Y ) ( u4 A ) ( u\[6\] A ) + ROUTED M1 ( 2000 7000 ) ( 7000 * ) + FIXED M2 ( 7000 7000 ) ( * 8000 ) ;
END NETS
END DESIGN
